generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum GlobalRole {
  ADMIN
  USER
}

enum TripStatus {
  DRAFT
  INVITING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Visibility {
  PRIVATE
  LINK_ONLY
  PUBLIC
}

enum InterestStatus {
  PENDING
  INTERESTED
  NOT_INTERESTED
  WAITLISTED
  CONFIRMED
  WITHDRAWN
}

enum MemberStatus {
  CONFIRMED
  WITHDRAWN
  REMOVED
}

enum MemberRole {
  PARTICIPANT
  ORGANIZER
}

enum RentalNeeds {
  NONE
  SKIS
  SNOWBOARD
  BOOTS
  FULL_PACKAGE
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum TravelMode {
  DRIVING
  FLYING
}

enum SchoolYear {
  FRESHMAN
  SOPHOMORE
  JUNIOR
  SENIOR
  ALUM
  OTHER
}

enum SleepingPreference {
  FLOOR
  BED
}

enum DriverRole {
  DRIVER
  PASSENGER
}

enum TransferDirection {
  TO_LODGING
  TO_AIRPORT
}

enum TransferAssignmentType {
  CAR_GROUP
  OWN
  SHUTTLE
}

enum ExpenseCategory {
  LODGING
  LIFT_TICKETS
  TRANSPORTATION
  FOOD
  EQUIPMENT_RENTAL
  MISC
}

// ─── Auth.js required models ────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application models ─────────────────────────────────

model User {
  id        String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  name          String?
  phone         String?
  image         String?
  role          GlobalRole @default(USER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // App relations
  organizedTrips    TripOrganizer[]    @relation("OrganizerUser")
  addedOrganizers   TripOrganizer[]    @relation("AddedByUser")
  memberships       TripMember[]
  interestResponses InterestResponse[]
  expenses          Expense[]
  expenseSplits     ExpenseSplit[]
  tripUpdates       TripUpdate[]
  tripPhotos        TripPhoto[]
  addedHouses       PotentialHouse[]
  transferAssignedBy TransferAssignment[] @relation("AssignedByUser")

  emailNotifyChanges       Boolean @default(true)
  emailNotifyAnnouncements Boolean @default(true)
}

model Trip {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String
  status     TripStatus @default(DRAFT)
  visibility Visibility @default(LINK_ONLY)

  // Location
  resort        String
  state         String?
  country       String  @default("US")
  resortWebsite String?

  // Dates
  startDate       DateTime
  endDate         DateTime
  inviteDeadline  DateTime?
  confirmDeadline DateTime?

  // Lodging
  selectedHouseId String?
  lodgingCheckIn  DateTime?
  lodgingCheckOut DateTime?
  lodgingNotes    String?

  // Capacity
  capacityMin Int?
  capacityMax Int?

  // Cost
  estimatedCostMin Decimal?
  estimatedCostMax Decimal?
  depositFloor     Decimal?
  depositBed       Decimal?
  currency         String   @default("USD")
  costNotes        String?

  // Meta
  description   String?
  tripInfo      String?
  coverImageUrl String?
  inviteToken   String   @unique @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  organizers        TripOrganizer[]
  members           TripMember[]
  interestResponses InterestResponse[]
  expenses          Expense[]
  expenseSplits     ExpenseSplit[]
  updates           TripUpdate[]
  photos            TripPhoto[]
  potentialHouses   PotentialHouse[]
  transportationDetails TransportationDetail[]
  transferGroups    TransferGroup[]
  transferAssignments TransferAssignment[]
}

model TripOrganizer {
  id      String   @id @default(cuid())
  tripId  String
  userId  String
  addedAt DateTime @default(now())
  addedBy String

  trip        Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user        User @relation("OrganizerUser", fields: [userId], references: [id])
  addedByUser User @relation("AddedByUser", fields: [addedBy], references: [id])

  @@unique([tripId, userId])
}

model InterestResponse {
  id     String @id @default(cuid())
  tripId String
  userId String?

  // Captured from form
  email String
  name  String
  phone String?

  status      InterestStatus @default(PENDING)
  submittedAt DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Form responses
  guestCount         Int                @default(1)
  rentalNeeds        RentalNeeds        @default(NONE)
  skillLevel         SkillLevel         @default(BEGINNER)
  skiDays            Int                @default(0)
  travelMode         TravelMode         @default(DRIVING)
  schoolYear         SchoolYear         @default(FRESHMAN)
  schoolYearOther    String?
  sleepingPreference SleepingPreference @default(FLOOR)
  comments           String?

  // Organizer notes
  organizerNotes String?

  // Tracking
  inviteEmailSentAt  DateTime?
  reminderSentAt     DateTime?
  confirmEmailSentAt DateTime?

  // Token for unauthenticated edits
  editToken String @unique @default(cuid())

  trip       Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id])
  tripMember TripMember?

  @@unique([tripId, email])
}

model TripMember {
  id                 String  @id @default(cuid())
  tripId             String
  userId             String
  interestResponseId String? @unique

  role   MemberRole   @default(PARTICIPANT)
  status MemberStatus @default(CONFIRMED)

  confirmedAt      DateTime  @default(now())
  withdrawnAt      DateTime?
  withdrawalReason String?

  // Per-member logistics
  rentalNeeds        RentalNeeds        @default(NONE)
  skillLevel         SkillLevel         @default(BEGINNER)
  skiDays            Int                @default(0)
  travelMode         TravelMode         @default(DRIVING)
  schoolYear         SchoolYear         @default(FRESHMAN)
  schoolYearOther    String?
  sleepingPreference SleepingPreference @default(FLOOR)
  fullTripAttendance Boolean            @default(true)
  tripArrivalDate    DateTime?
  tripDepartureDate  DateTime?
  roomAssignment     String?

  // Payment tracking
  depositAmount          Decimal?
  depositPaid            Boolean  @default(false)
  depositPaidAt          DateTime?
  depositConfirmedBySelf Boolean  @default(false)
  balancePaid            Boolean  @default(false)
  balancePaidAt          DateTime?

  trip             Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id])
  interestResponse InterestResponse? @relation(fields: [interestResponseId], references: [id])

  transportationDetail TransportationDetail?
  surveyResponse       SurveyResponse?
  transferAssignments  TransferAssignment[]
  driverForGroup       TransferGroup[]      @relation("GroupDriver")
  passengerOfDriver    TransportationDetail[] @relation("DriverMember")

  @@unique([tripId, userId])
}

model Expense {
  id          String          @id @default(cuid())
  tripId      String
  paidById    String
  category    ExpenseCategory
  description String
  amount      Decimal
  currency    String          @default("USD")
  date        DateTime
  receiptUrl  String?
  notes       String?
  isSettledUp Boolean         @default(false)
  createdAt   DateTime        @default(now())

  trip   Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy User          @relation(fields: [paidById], references: [id])
  splits ExpenseSplit[]
}

model ExpenseSplit {
  id        String   @id @default(cuid())
  expenseId String
  tripId    String
  userId    String
  share     Decimal
  settled   Boolean  @default(false)
  settledAt DateTime?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
}

model TripUpdate {
  id        String   @id @default(cuid())
  tripId    String
  authorId  String
  title     String
  body      String
  pinned    Boolean  @default(false)
  sentEmail Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}

model TripPhoto {
  id           String    @id @default(cuid())
  tripId       String
  uploadedById String
  url          String
  caption      String?
  takenAt      DateTime?
  createdAt    DateTime  @default(now())

  trip       Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])
}

model SurveyResponse {
  id                  String   @id @default(cuid())
  tripId              String
  tripMemberId        String   @unique
  overallRating       Int
  highlights          String?
  improvements        String?
  wouldReturnToResort Boolean?
  wouldReturnToHouse  Boolean?
  additionalComments  String?
  submittedAt         DateTime @default(now())

  tripMember TripMember @relation(fields: [tripMemberId], references: [id])
}

model TransportationDetail {
  id           String @id @default(cuid())
  tripId       String
  tripMemberId String @unique

  travelMode TravelMode

  // Flying fields
  arrivalAirport         String?
  departureSameAsArrival Boolean?  @default(true)
  departureAirport       String?
  arrivalTime            DateTime?
  departureTime          DateTime?
  rentingCar             Boolean?

  // Driving fields
  driveRole           DriverRole?
  driveArrivalTime    DateTime?
  driveDepartureTime  DateTime?
  confirmedPassengers Int?
  extraSeats          Int?
  driverTripMemberId  String?

  comments  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripMember TripMember @relation(fields: [tripMemberId], references: [id])
  driver     TripMember? @relation("DriverMember", fields: [driverTripMemberId], references: [id])
}

model TransferGroup {
  id          String            @id @default(cuid())
  tripId      String
  direction   TransferDirection
  name        String
  driverId    String?
  maxCapacity Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  trip        Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver      TripMember?        @relation("GroupDriver", fields: [driverId], references: [id])
  assignments TransferAssignment[]
}

model TransferAssignment {
  id              String                 @id @default(cuid())
  tripId          String
  tripMemberId    String
  direction       TransferDirection
  type            TransferAssignmentType
  transferGroupId String?
  assignedAt      DateTime               @default(now())
  assignedBy      String

  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripMember    TripMember     @relation(fields: [tripMemberId], references: [id])
  transferGroup TransferGroup? @relation(fields: [transferGroupId], references: [id])
  assignedByUser User          @relation("AssignedByUser", fields: [assignedBy], references: [id])

  @@unique([tripMemberId, direction])
}

model PotentialHouse {
  id                String   @id @default(cuid())
  tripId            String
  addedById         String
  listingUrl        String
  price             Decimal
  bedSpots          Int
  floorSpots        Int
  pricePerBedSpot   Decimal?
  pricePerFloorSpot Decimal?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trip    Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  addedBy User @relation(fields: [addedById], references: [id])
}
